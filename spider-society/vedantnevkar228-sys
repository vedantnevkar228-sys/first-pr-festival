<div
  class="spider-card"
  data-name="vedantnevkar228-sys"
  data-alias="GHOST_IS-PRO"
  data-github="vedantnevkar228-sys"
  data-suit="#E62429"
>
  <style>
    .spider-card {
      --suit: #e62429;
      --suit-deep: #7a0d12;
      --suit-glow: #ff4d52;
      --ink: #07070a;
      --ink-mid: #1a0708;
      --paper: #ece7df;
      --muted: rgba(236, 231, 223, 0.55);
      --web-line: rgba(255, 255, 255, 0.07);

      width: 320px;
      height: 440px;
      box-sizing: border-box;
      padding: 20px;
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
      color: var(--paper);
      background: radial-gradient(circle at 24% -6%, var(--suit-deep), var(--ink) 62%);
      border: 2px solid var(--suit);
      border-radius: 18px;
      overflow: hidden;
      position: relative;
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.55), inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    }

    .spider-card::before {
      content: "";
      position: absolute;
      inset: -12%;
      background:
        repeating-radial-gradient(circle at 20% 4%, var(--web-line) 0 1px, transparent 1px 24px),
        repeating-conic-gradient(from -25deg at 20% 4%, var(--web-line) 0deg 0.5deg, transparent 0.5deg 13deg);
      opacity: 0.6;
      pointer-events: none;
    }

    .spider-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent 40%);
      pointer-events: none;
    }

    .halftone {
      position: absolute;
      left: -34px;
      top: 132px;
      width: 150px;
      height: 150px;
      background-image: radial-gradient(rgba(230, 36, 41, 0.5) 1.4px, transparent 1.4px);
      background-size: 7px 7px;
      -webkit-mask-image: radial-gradient(circle, #000 0%, transparent 68%);
      mask-image: radial-gradient(circle, #000 0%, transparent 68%);
      opacity: 0.4;
      pointer-events: none;
    }

    .hologram {
      position: absolute;
      top: 27px;
      right: -40px;
      width: 155px;
      padding: 3px 0;
      transform: rotate(45deg);
      text-align: center;
      font-family: ui-monospace, monospace;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 3px;
      color: #fff1ee;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
      background: linear-gradient(100deg, #ffb3b0, var(--suit) 35%, var(--suit-deep) 55%, var(--suit) 75%, #ffb3b0);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
      z-index: 3;
    }

    .corner {
      position: absolute;
      width: 13px;
      height: 13px;
      border-color: rgba(230, 36, 41, 0.55);
      border-style: solid;
      pointer-events: none;
    }
    .corner.tl { top: 9px; left: 9px; border-width: 2px 0 0 2px; }
    .corner.bl { bottom: 9px; left: 9px; border-width: 0 0 2px 2px; }
    .corner.br { bottom: 9px; right: 9px; border-width: 0 2px 2px 0; }

    .web-mark {
      position: absolute;
      right: -55px;
      bottom: 30px;
      width: 230px;
      height: 230px;
      color: rgba(230, 36, 41, 0.14);
      pointer-events: none;
    }

    .content {
      position: relative;
      z-index: 2;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    .meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .node-tag {
      font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
      font-size: 10px;
      letter-spacing: 1.5px;
      color: var(--muted);
      border: 1px solid rgba(255, 255, 255, 0.16);
      padding: 3px 7px;
      border-radius: 3px;
    }

    .pulse {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--suit-glow);
      animation: pulse 2.4s ease-out infinite;
    }
    @keyframes pulse {
      0%   { box-shadow: 0 0 0 0 rgba(255, 77, 82, 0.55); }
      70%  { box-shadow: 0 0 0 8px rgba(255, 77, 82, 0); }
      100% { box-shadow: 0 0 0 0 rgba(255, 77, 82, 0); }
    }

    .avatar {
      margin-top: 18px;
      width: 88px;
      height: 88px;
      object-fit: cover;
      background: var(--ink-mid);
      border: 2px solid var(--suit);
      clip-path: polygon(18% 0, 100% 0, 100% 82%, 82% 100%, 0 100%, 0 18%);
      box-shadow: 0 0 0 4px rgba(230, 36, 41, 0.14), 0 0 26px rgba(230, 36, 41, 0.45);
    }

    .alias {
      margin: 16px 0 1px;
      font-family: Impact, "Arial Narrow Bold", Haettenschweiler, "Franklin Gothic Bold", sans-serif;
      font-size: 32px;
      line-height: 0.95;
      letter-spacing: 0.5px;
      color: var(--suit);
      -webkit-text-stroke: 1px rgba(0, 0, 0, 0.35);
      paint-order: stroke fill;
      text-shadow: 0 0 20px rgba(230, 36, 41, 0.55);
      transform: skewX(-4deg) scaleY(1.03);
      transform-origin: left;
    }

    .name {
      margin: 6px 0 0;
      font-size: 14px;
      opacity: 0.8;
    }

    .handle {
      margin-top: 3px;
      font-family: ui-monospace, monospace;
      font-size: 12px;
      color: var(--muted);
    }

    .divider {
      position: relative;
      height: 1px;
      margin: 18px 0 16px;
      background: linear-gradient(90deg, transparent, var(--suit) 15%, var(--suit) 85%, transparent);
      opacity: 0.55;
    }
    .divider::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      width: 6px;
      height: 6px;
      transform: translate(-50%, -50%) rotate(45deg);
      background: var(--suit);
      box-shadow: 0 0 8px rgba(230, 36, 41, 0.7);
    }

    .skills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 0;
      margin: 0;
      list-style: none;
    }

    .skills li {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px 6px 8px;
      font-size: 11.5px;
      letter-spacing: 0.2px;
      border: 1px solid rgba(230, 36, 41, 0.55);
      border-radius: 3px 12px 12px 3px;
      background: linear-gradient(180deg, rgba(230, 36, 41, 0.16), rgba(230, 36, 41, 0.05));
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .skills li .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--suit-glow);
      box-shadow: 0 0 6px rgba(255, 77, 82, 0.9);
      flex: none;
    }

    .meter { margin-top: 16px; }
    .meter-label {
      display: flex;
      justify-content: space-between;
      font-family: ui-monospace, monospace;
      font-size: 9.5px;
      letter-spacing: 1.5px;
      color: var(--muted);
      margin-bottom: 6px;
    }
    .meter-track {
      height: 5px;
      border-radius: 3px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(230, 36, 41, 0.3);
      overflow: hidden;
    }
    .meter-fill {
      height: 100%;
      width: 92%;
      background: linear-gradient(90deg, var(--suit-deep), var(--suit), var(--suit-glow));
      box-shadow: 0 0 8px rgba(255, 77, 82, 0.6);
    }

    .footer {
      margin-top: auto;
      display: flex;
      justify-content: space-between;
      font-family: ui-monospace, monospace;
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      opacity: 0.45;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding-top: 10px;
    }
  </style>

  <div class="halftone"></div>

  <span class="corner tl"></span>
  <span class="corner bl"></span>
  <span class="corner br"></span>
  <div class="hologram">VERIFIED</div>

  <svg class="web-mark" viewBox="0 0 100 100" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <ellipse cx="50" cy="55" rx="10" ry="14"/>
      <ellipse cx="50" cy="37" rx="6" ry="7"/>
      <path d="M42 47 L20 33 M42 52 L14 50 M42 58 L18 66 M42 64 L26 80"/>
      <path d="M58 47 L80 33 M58 52 L86 50 M58 58 L82 66 M58 64 L74 80"/>
    </g>
  </svg>

  <div class="content">
    <div class="meta-row">
      <span class="node-tag">NODE&nbsp;//&nbsp;228</span>
      <span class="pulse"></span>
    </div>

    <img class="avatar" src="https://github.com/vedantnevkar228-sys.png" alt="GHOST_IS-PRO avatar" />

    <h1 class="alias">GHOST_IS-PRO</h1>
    <p class="name">Vedant Nevkar</p>
    <p class="handle">@vedantnevkar228-sys</p>

    <div class="divider"></div>

    <ul class="skills">
      <li><span class="dot"></span>Full-Stack Dev</li>
      <li><span class="dot"></span>UI / UX</li>
      <li><span class="dot"></span>Debug Ninja</li>
    </ul>

    <div class="meter">
      <div class="meter-label"><span>SPIDER-SENSE</span><span>92%</span></div>
      <div class="meter-track"><div class="meter-fill"></div></div>
    </div>

    <div class="footer">
      <span>Spider-Society</span>
      <span>Earth-1610</span>
    </div>
  </div>
</div>
